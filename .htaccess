# Настройки сервера Beget (Apache). На GitHub Pages этот файл не действует.
#
# Зачем. Сайт переезжает с GitHub Pages на Beget (26.09.2026), и сервер
# должен вести себя так же, как Pages, — иначе ломается то, что на Pages
# работало само. Сверено прогоном «GitHub против new.heatcalc.ru» перед
# переключением домена; всё, что ниже, — найденные там расхождения.
#
# Файл заливается в обе папки (heatcalc.ru и new.heatcalc.ru), поэтому
# различия между ними решаются по имени хоста, а не двумя файлами.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # http → https. Pages делал это сам. Apache у Beget стоит за nginx,
    # поэтому смотрим на заголовок, который nginx передаёт; редиректим только
    # при явном «http» — при пустом заголовке молчим, чтобы не зациклиться.
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Адрес без .html (heatcalc.ru/oprosnik) — Pages отдавал oprosnik.html.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]

    # Метка для кэша: js/css с «?v=» (см. ниже, блок mod_headers).
    RewriteCond %{QUERY_STRING} ^v=
    RewriteRule \.(js|css)$ - [E=HC_VERSIONED:1,L]
</IfModule>

# Сжатие текста. app.js (~7,8 МБ) и catalog.js (~1,5 МБ) уходят на телефон
# в несжатом виде, если сервер сам не сжимает: на мобильной сети это главная
# задержка запуска. Если сжатие у Beget уже включено, директивы ничего не меняют.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/x-javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # Проверочную копию поисковикам не показываем, основной сайт — показываем.
    # Раньше запрет стоял без условия и при переезде уехал бы на heatcalc.ru.
    SetEnvIfNoCase Host ^new\.heatcalc\.ru$ HC_TEST_COPY
    Header set X-Robots-Tag "noindex, nofollow, noarchive" env=HC_TEST_COPY

    # Кэш как на Pages: 10 минут. У Beget по умолчанию неделя — тогда правка
    # скриптов без ?v= (ленивые модули), главной страницы и
    # price_index.json доезжала бы до людей неделю. Картинки — как у Beget.
    <FilesMatch "\.(html|js|css|json|xml|txt|webmanifest)$">
        Header unset Expires
        Header set Cache-Control "max-age=600"
    </FilesMatch>

    # Файлы с «?v=» (app.js?v=14.62, catalog.js?v=3.48 …) меняют адрес при каждой
    # правке, поэтому держать их можно долго: повторный заход не качает заново
    # ~10 МБ скриптов, а берёт их из кэша браузера. Без этого раз в 10 минут
    # браузер перепроверял каждый файл, а после перепроверки (особенно на слабой
    # связи) часть скриптов не доезжала — «Загрузка калькулятора» зависала и
    # страница падала в «загрузился с ошибкой».
    Header set Cache-Control "public, max-age=2592000, immutable" env=HC_VERSIONED
</IfModule>

# Сжатие. На Pages его делал сам хостинг. app.js весит 7.7 МБ, а сжатый —
# 1.9 МБ: без сжатия при заходе уходило около 13 МБ вместо ~3 МБ, и на мобильной
# связи калькулятор грузился минутами.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/manifest+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml application/rss+xml
</IfModule>
